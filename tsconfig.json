{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared": ["packages/shared/src/index.tsx"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "plugins/**/*.ts", "plugins/**/*.tsx"]
}
